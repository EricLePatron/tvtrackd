# ============================================================
# tvtrackd — variables d'environnement
# Copie ce fichier en `.env` puis renseigne les valeurs SECRÈTES.
# `.env` est gitignoré : n'y committe JAMAIS de secret.
# ============================================================

# --- Supabase : valeurs PUBLIQUES (projet wrzexhpjsmddsbimvqaw) ---
# La clé publishable est publique (exposée côté client), elle peut rester ici.
VITE_SUPABASE_URL="https://wrzexhpjsmddsbimvqaw.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_V4OGAtB-4hxVRq_BZZcRhA_5C2zgRIl"
VITE_SUPABASE_PROJECT_ID="wrzexhpjsmddsbimvqaw"
SUPABASE_URL="https://wrzexhpjsmddsbimvqaw.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_V4OGAtB-4hxVRq_BZZcRhA_5C2zgRIl"
SUPABASE_PROJECT_ID="wrzexhpjsmddsbimvqaw"

# --- URL publique du site (canonical, OG, sitemap, liens de partage) ---
# VITE_SITE_URL est injectée au BUILD (fait foi) ; SITE_URL est la valeur runtime
# (aussi déclarée dans wrangler.jsonc > vars). Mettre l'URL workers.dev après le 1er déploiement.
VITE_SITE_URL="https://tvtrackd.com"
SITE_URL="https://tvtrackd.com"

# --- Secrets : à renseigner en LOCAL uniquement (jamais committer) ---
# Clé service_role : Supabase → Project Settings → API → clé « service_role » (sb_secret_…)
# Utilisée côté serveur (client.server.ts) pour les opérations admin qui bypassent la RLS.
SUPABASE_SERVICE_ROLE_KEY=""
# Token d'intégration Notion pour le formulaire de feedback.
# https://www.notion.so/my-integrations — et partager la base feedback avec l'intégration.
NOTION_API_KEY=""

# Déploiement Cloudflare : les secrets ci-dessus se posent avec
#   bunx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
#   bunx wrangler secret put NOTION_API_KEY
# Pour `bun run preview` (workerd local), les mettre aussi dans `.dev.vars` (gitignoré).
